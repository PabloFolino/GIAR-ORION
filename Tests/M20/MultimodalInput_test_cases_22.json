{
  "test_suite": "GIAR-ORION M20 - MultimodalInput",
  "schema_draft": "2020-12",
  "description": "22 casos de prueba para validar MultimodalInput.schema.json.",
  "summary": {
    "positive_cases": 10,
    "negative_cases": 12,
    "total_cases": 22
