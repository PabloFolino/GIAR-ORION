  "cases": [
    {
      "id": "MMI-001",
      "name": "Texto incorporado",
      "data": {
        "modality": "text",
        "items": [
          {
            "type": "text",
            "content": "Analizar esta información."
          }
        ]
      },
      "expected_valid": true
    },
    {
