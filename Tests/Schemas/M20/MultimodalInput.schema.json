{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:giar-orion:schema:multimodal-input:1.1",
  "title": "GIAR-ORION Multimodal Input",
  "description": "Entrada multimodal con contenido incorporado o referencia estructurada a un recurso.",
  "type": "object",
  "required": [
    "modality",
    "items"
  ],
  "properties": {
    "modality": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input_item"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "input_item": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "content": {},
        "reference": {
          "$ref": "urn:giar-orion:schema:resource-reference:1.0"
        },
        "metadata": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "reference"
            ]
          }
        },
        {
          "required": [
            "reference"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
